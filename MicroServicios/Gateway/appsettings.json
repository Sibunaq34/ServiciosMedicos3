{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ReverseProxy": {
    "Routes": {
      "puestos-route": {
        "ClusterId": "puestos-cluster",
        "Match": {
          "Path": "/Puestos/{**catch-all}"

        }

      },
      "usario-route": {
        "ClusterId": "usario-cluster",
        "Match": {
          "Path": "/Usuarios/{**catch-all}"
        }
      },
      "auth-route": {
        "ClusterId": "usario-cluster",
        "Match": {
          "Path": "/api/autenticacion/{**catch-all}"
        }
      },
      "usuarios-api-route": {
        "ClusterId": "usario-cluster",
        "Match": {
          "Path": "/api/usuarios/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "puestos-cluster": {
        "Destinations": {
          "MicroServiciosPuestos": {
            "Address": "http://localhost:5222/"
          }
        }
      },
      "usario-cluster": {
        "Destinations": {
          "MicroServiciosUsuarios": {
            "Address": "http://localhost:5221/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
