{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ReverseProxy": {
    "Routes": {
      "puestos-route": {
        "ClusterId": "puestos-cluster",
        "Match": {
          "Path": "/Puestos/{**catch-all}"
        }
      },

      "auth-route": {
        "ClusterId": "usuario-cluster",
        "Match": {
          "Path": "/api/autenticacion/{**catch-all}"
        }
      },

      "usuarios-api-route": {
        "ClusterId": "usuario-cluster",
        "Match": {
          "Path": "/api/usuarios/{**catch-all}"
        }
      },

      "empleados-route": {
        "ClusterId": "empleados-cluster",
        "Match": {
          "Path": "/Empleados/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "puestos-cluster": {
        "Destinations": {
          "MicroServiciosPuestos": {
            "Address": "http://localhost:5222/"
          }
        }
      },

      "empleados-cluster": {
        "Destinations": {
          "MicroServiciosEmpleados": {
            "Address": "http://localhost:5223/"
          }
        }
      },

      "usuario-cluster": {
        "Destinations": {
          "MicroServiciosUsuario": {
            "Address": "http://localhost:5221/"
          }
        }
      }
    }
  }
}