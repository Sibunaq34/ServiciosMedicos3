      "name": "03 - Oferentes por puesto (CORE2)",
      "item": [
        {
          "name": "Página 1 por Gateway",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Respuesta controlada', () => pm.expect(pm.response.code).to.be.oneOf([200, 404, 500]));",
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.test('Contrato data/meta', () => { pm.expect(json.data).to.be.an('array'); pm.expect(json.meta).to.be.an('object'); });",
                  "  pm.test('Servidor respeta pageSize', () => pm.expect(json.data.length).to.be.at.most(Number(pm.collectionVariables.get('pageSize'))));",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/Puestos/{{codigoPuesto}}/oferentes?page=1&pageSize={{pageSize}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "Puestos",
                "{{codigoPuesto}}",
                "oferentes"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
