  "item": [
    {
      "name": "01 - Usuario y autenticación",
      "item": [
        {
          "name": "Login por Gateway - credenciales configurables",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('La API respondió', () => pm.expect(pm.response.code).to.be.oneOf([200, 401, 403, 500]));",
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.test('Incluye token', () => pm.expect(json.token).to.be.a('string').and.not.empty);",
                  "  pm.collectionVariables.set('token', json.token);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"Admin1\",\n  \"contrasena\": \"Prueba123*\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/autenticacion/login",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "autenticacion",
                "login"
              ]
            },
            "description": "Prueba el login mediante el Gateway. Si retorna 200, guarda automáticamente el JWT en {{token}}. Un 500 suele indicar configuración faltante de BD, AES o JWT."
          },
          "response": []
        },
        {
          "name": "Login directo al microservicio",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('El microservicio respondió', () => pm.expect(pm.response.code).to.be.oneOf([200, 401, 403, 500]));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"Admin1\",\n  \"contrasena\": \"Prueba123*\"\n}"
            },
            "url": {
              "raw": "{{usuarioUrl}}/api/autenticacion/login",
              "host": [
                "{{usuarioUrl}}"
              ],
              "path": [
                "api",
                "autenticacion",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login inválido - campos vacíos (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Devuelve 400', () => pm.response.to.have.status(400));",
                  "pm.test('Incluye mensaje', () => pm.expect(pm.response.json()).to.have.property('mensaje'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"\",\n  \"contrasena\": \"\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/autenticacion/login",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
