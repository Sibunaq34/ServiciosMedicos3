              "mode": "raw",
              "raw": "{\n  \"usuario\": \"postman_prueba\",\n  \"nombreCompleto\": \"Usuario de prueba Postman\",\n  \"correo\": \"postman.prueba@example.com\",\n  \"contrasena\": \"Prueba1234.\",\n  \"idRol\": 1,\n  \"estado\": \"Activo\"\n}"
